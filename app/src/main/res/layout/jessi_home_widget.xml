<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/jessi_widget_panel" android:padding="0dp">
    <!-- FIT_CENTER preserves circular chart geometry on launchers with
         differing widget cell sizes. Never stretch the bitmap nonuniformly. -->
    <ImageView android:id="@+id/jessi_widget_image"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/jessi_widget_description"/>
    <ImageView android:id="@+id/jessi_widget_eye"
        android:layout_width="38dp" android:layout_height="38dp"
        android:padding="9dp" android:layout_gravity="top|left"
        android:visibility="gone" android:contentDescription="پنهان یا نمایش موجودی"/>
    <TextView android:id="@+id/jessi_widget_previous"
        android:layout_width="34dp" android:layout_height="36dp"
        android:layout_gravity="bottom|left"
        android:gravity="center" android:text="‹" android:textSize="30sp"
        android:textColor="#EBDAFF" android:visibility="gone"
        android:contentDescription="حساب قبلی"/>
    <TextView android:id="@+id/jessi_widget_next"
        android:layout_width="34dp" android:layout_height="36dp"
        android:layout_marginLeft="34dp" android:layout_gravity="bottom|left"
        android:gravity="center" android:text="›" android:textSize="30sp"
        android:textColor="#EBDAFF" android:visibility="gone"
        android:contentDescription="حساب بعدی"/>
</FrameLayout>
