<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="10dp" android:paddingRight="10dp"
    android:paddingTop="7dp" android:paddingBottom="7dp"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@drawable/jessi_widget_panel">
    <TextView android:layout_width="34dp" android:layout_height="2dp"
        android:layout_gravity="right" android:background="@drawable/jessi_widget_accent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="23dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/jessi_balance_title"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="موجودی کل" android:textColor="#E7E3F3"
            android:textSize="11sp" android:textStyle="bold"
            android:singleLine="true" android:ellipsize="end"/>
        <ImageView android:id="@+id/jessi_widget_eye"
            android:layout_width="27dp" android:layout_height="27dp"
            android:padding="6dp" android:src="@drawable/jessi_widget_eye_off"
            android:contentDescription="پنهان یا نمایش موجودی"/>
    </LinearLayout>
    <TextView android:id="@+id/jessi_balance_amount"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical|right"
        android:text="••••••" android:textColor="#FFFFFF"
        android:textSize="20sp" android:textStyle="bold"
        android:singleLine="true" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="20dp" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/jessi_balance_caption"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="تومان" android:textSize="9sp"
            android:textColor="#AAA6C2" android:singleLine="true"
            android:ellipsize="end"/>
        <TextView android:id="@+id/jessi_widget_previous"
            android:layout_width="27dp" android:layout_height="24dp"
            android:gravity="center" android:text="›" android:textSize="22sp"
            android:textColor="#DDD2FF"
            android:contentDescription="حساب قبلی"/>
        <TextView android:id="@+id/jessi_balance_page"
            android:layout_width="26dp" android:layout_height="wrap_content"
            android:gravity="center" android:text="۱/۱"
            android:textColor="#BBB4D0" android:textSize="9sp"
            android:singleLine="true"/>
        <TextView android:id="@+id/jessi_widget_next"
            android:layout_width="27dp" android:layout_height="24dp"
            android:gravity="center" android:text="‹" android:textSize="22sp"
            android:textColor="#DDD2FF"
            android:contentDescription="حساب بعدی"/>
    </LinearLayout>
</LinearLayout>
