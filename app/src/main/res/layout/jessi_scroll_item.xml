<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jessi_scroll_row"
    android:layout_width="match_parent" android:layout_height="36dp"
    android:layoutDirection="rtl" android:orientation="vertical"
    android:gravity="center_vertical" android:paddingTop="2dp"
    android:paddingBottom="2dp">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/jessi_scroll_item_title"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:gravity="right"
            android:textColor="#F5F3FF" android:textStyle="bold"
            android:textSize="10sp" android:maxLines="1"
            android:ellipsize="end"/>
        <TextView android:id="@+id/jessi_scroll_amount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginRight="5dp" android:textColor="#BDA4FF"
            android:textSize="9sp" android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="1dp">
        <TextView android:id="@+id/jessi_scroll_item_note"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#AAA4C1" android:textSize="8.5sp"
            android:maxLines="1" android:ellipsize="end"/>
        <ProgressBar android:id="@+id/jessi_scroll_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="3dp" android:layout_marginRight="6dp"
            android:indeterminate="false" android:max="100"
            android:progressTint="#AA98F9"
            android:progressBackgroundTint="#423951"/>
    </LinearLayout>
</LinearLayout>
