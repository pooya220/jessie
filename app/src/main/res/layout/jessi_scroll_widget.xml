<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical"
    android:paddingLeft="9dp" android:paddingRight="9dp"
    android:paddingTop="8dp" android:paddingBottom="5dp"
    android:background="@drawable/jessi_widget_panel">
    <View android:layout_width="32dp" android:layout_height="2dp"
        android:layout_gravity="right" android:background="@drawable/jessi_widget_accent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/jessi_scroll_title"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="اقساط"
            android:textSize="11sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:singleLine="true"
            android:ellipsize="end"/>
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="JESSI"
            android:textColor="#897FAD" android:textSize="8sp"/>
    </LinearLayout>
    <ListView android:id="@+id/jessi_scroll_list"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="#40354E"
        android:dividerHeight="1dp" android:cacheColorHint="#00000000"
        android:scrollbars="none" android:clipToPadding="false"
        android:paddingLeft="0dp" android:paddingRight="0dp"/>
    <TextView android:id="@+id/jessi_scroll_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:gravity="center"
        android:textSize="10sp" android:textColor="#B3A8CB"
        android:text="موردی ثبت نشده" android:visibility="gone"/>
</LinearLayout>
